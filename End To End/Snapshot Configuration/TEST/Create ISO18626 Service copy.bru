meta {
  name: Create ISO18626 Service copy
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/ill/directory/service?filters=status.value%3Dmanaged&perPage=100&sort=id
  body: json
  auth: inherit
}

params:query {
  filters: status.value%3Dmanaged
  perPage: 100
  sort: id
}

body:json {
  {
    "name": "SNAPSHOT-ISO18626",
    "type": {{iso18626Type}},
    "businessFunction": "2c93809393b0c6e30193b0c8edf90031",
    "address": "https://sandbox.openrs.k-int.com/api/_/invoke/tenant/ill/ill/externalApi/iso18626",
    "status": "managed"
  }
}

script:pre-request {
  const serviceTypes = bru.getVar("refdata").results.find(rdc => rdc.desc === "Service.Type")
  const iso18626Type = serviceTypes.values.find(rdv => rdv.value === 'iso18626')
  
  bru.setVar("iso18626Type", iso18626Type);
}

settings {
  encodeUrl: true
}
