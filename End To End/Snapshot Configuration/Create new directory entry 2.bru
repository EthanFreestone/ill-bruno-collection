meta {
  name: Create new directory entry 2
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/ill/directory/entry
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Example Institution 2",
    "type": "institution",
    "slug": "EXINT2",
    "lmsLocationCode": "EXINT2",
    "symbols": [
      {
        "_delete": false,
        "authority": {
          "id": {{illAuthorityId}}
        },
        "symbol": "EXINT2"
      }
    ],
    "services": [
      {
        "_delete": false,
        "slug": "EXINT2",
        "service": {
          "id": {{iso18626ServiceId}}
        }
      }
    ],
    "status": "managed",
    "id": {{uniqueUUID}}
  }
}

script:post-response {
  bru.setVar('directoryTWOId', res.body.id)
}

settings {
  encodeUrl: true
}
