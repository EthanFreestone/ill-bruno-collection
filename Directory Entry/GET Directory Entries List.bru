meta {
  name: GET Directory Entries List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/ill/directory/entry?filters=type.value%3Dinstitution&perPage=1000&stats=true
  body: none
  auth: inherit
}

params:query {
  filters: type.value=institution
  perPage: 1000
  stats: true
  ~sort: name;asc
}
